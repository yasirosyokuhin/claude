{
  "fish": {
    "sake": {
      "name": "サケ",
      "reading": "しろざけ",
      "emoji": "🐟",
      "rarity": "rare",
      "desc": "秋に生まれた川へ戻る北海道の代表魚。川では口を使わず、専用のサーモン仕掛けが要る難敵。"
    },
    "sakuramasu": {
      "name": "サクラマス",
      "reading": "さくらます",
      "emoji": "🌸",
      "rarity": "uncommon",
      "desc": "降海型がサクラマス、川に残る型がヤマメ。同じ魚。"
    },
    "amemasu": {
      "name": "アメマス",
      "reading": "あめます",
      "emoji": "🐟",
      "rarity": "common",
      "desc": "白い斑点のイワナの仲間。川残留型はエゾイワナ。"
    },
    "oshorokoma": {
      "name": "オショロコマ",
      "reading": "おしょろこま",
      "emoji": "🐟",
      "rarity": "uncommon",
      "desc": "冷たい源流域にすむ北海道の在来イワナ。"
    },
    "nijimasu": {
      "name": "ニジマス",
      "reading": "にじます",
      "emoji": "🌈",
      "rarity": "common",
      "desc": "北米原産だが道内河川・湖に広く定着。"
    },
    "brown": {
      "name": "ブラウントラウト",
      "reading": "ぶらうんとらうと",
      "emoji": "🐟",
      "rarity": "uncommon",
      "desc": "欧州原産。支笏湖・尻別川などで大型化。"
    },
    "ito": {
      "name": "イトウ",
      "reading": "いとう",
      "emoji": "🐉",
      "rarity": "legend",
      "desc": "日本最大の淡水魚。天塩川・釧路川水系にすむ「幻の魚」。"
    },
    "wakasagi": {
      "name": "ワカサギ",
      "reading": "わかさぎ",
      "emoji": "🐟",
      "rarity": "common",
      "desc": "ダム湖の氷上釣りで人気。天ぷらが定番。"
    },
    "ugui": {
      "name": "ウグイ",
      "reading": "うぐい",
      "emoji": "🐟",
      "rarity": "common",
      "desc": "川に最も普通の魚。エゾウグイ・マルタも近い仲間。"
    },
    "fukudojo": {
      "name": "フクドジョウ",
      "reading": "ふくどじょう",
      "emoji": "🐟",
      "rarity": "uncommon",
      "desc": "北海道在来のドジョウの仲間。川底にすむ。"
    },
    "kajika": {
      "name": "カジカ",
      "reading": "かじか",
      "emoji": "🐟",
      "rarity": "uncommon",
      "desc": "川底の肉食魚。卵の大きさで型が分かれるが同じ仲間。"
    },
    "koi": {
      "name": "コイ",
      "reading": "こい",
      "emoji": "🐟",
      "rarity": "common",
      "desc": "下流やダム湖の止水域にすむ大型魚。"
    },
    "funa": {
      "name": "フナ",
      "reading": "ふな",
      "emoji": "🐟",
      "rarity": "common",
      "desc": "ギンブナなど。止水域にごく普通。"
    },
    "kawayatsume": {
      "name": "カワヤツメ",
      "reading": "かわやつめ",
      "emoji": "🐟",
      "rarity": "rare",
      "desc": "目が並んで見えるヤツメウナギの仲間。食用・薬用に。"
    },
    "ayu": {
      "name": "アユ",
      "reading": "あゆ",
      "emoji": "🐟",
      "rarity": "rare",
      "desc": "清流の指標魚。後志利別川など道南の限られた川に。"
    },
    "shishamo": {
      "name": "シシャモ",
      "reading": "ししゃも",
      "emoji": "🐟",
      "rarity": "rare",
      "desc": "本物のシシャモは鵡川など北海道太平洋岸だけの固有種。"
    },
    "himemasu": {
      "name": "ヒメマス",
      "reading": "ひめます",
      "emoji": "🐟",
      "rarity": "rare",
      "desc": "ベニザケの湖沼残留型。冷たい湖にすむ銀色の魚体は「湖の宝石」。産卵期は真っ赤に染まる。"
    },
    "karafutomasu": {
      "name": "カラフトマス",
      "reading": "からふとます",
      "emoji": "🐟",
      "rarity": "rare",
      "desc": "オホーツクの川に群れで遡上するサケの仲間。背が盛り上がったオスは「セッパリマス」と呼ばれる。"
    },
    "kawamasu": {
      "name": "カワマス",
      "reading": "かわます",
      "emoji": "🐟",
      "rarity": "rare",
      "desc": "北米原産のブルックトラウト。一部の湖沼に定着。橙色の腹と白い鰭の縁、青い縁取りの赤い斑が美しい。"
    },
    "chika": {
      "name": "チカ",
      "reading": "ちか",
      "emoji": "🐟",
      "rarity": "uncommon",
      "desc": "ワカサギによく似た汽水の魚。河口や港で群れる。天ぷらや南蛮漬けが絶品。"
    },
    "tomiyo": {
      "name": "トミヨ",
      "reading": "とみよ",
      "emoji": "🐟",
      "rarity": "uncommon",
      "desc": "とげを持つ小魚。湧き水の細流にすみ、水草で巣を作る。エゾトミヨ等トミヨ属を1つに統合。"
    },
    "itoyo": {
      "name": "イトヨ",
      "reading": "いとよ",
      "emoji": "🐟",
      "rarity": "common",
      "desc": "背に3本のとげ。春に川へのぼり、オスは喉が婚姻色で赤く染まる。巣を作って卵を守る。"
    },
    "sunayatsume": {
      "name": "スナヤツメ",
      "reading": "すなやつめ",
      "emoji": "🐟",
      "rarity": "uncommon",
      "desc": "小型のヤツメウナギ。砂にもぐって暮らす。目立たないが、きれいな流れのしるし。"
    },
    "ukigori": {
      "name": "ウキゴリ",
      "reading": "うきごり",
      "emoji": "🐟",
      "rarity": "common",
      "desc": "川底にすむハゼの仲間。中流から河口までごく普通。ウキゴリ類を1つに統合。"
    },
    "ezohotoke": {
      "name": "エゾホトケドジョウ",
      "reading": "えぞほとけどじょう",
      "emoji": "🐟",
      "rarity": "rare",
      "desc": "湿原の泥底にすむ小さなドジョウ。数が減っている希少種のため、釣れたらそっとリリース（売却0円）。"
    },
    "numagarei": {
      "name": "ヌマガレイ",
      "reading": "ぬまがれい",
      "emoji": "🐟",
      "rarity": "rare",
      "desc": "海のカレイなのに川へのぼる変わり者。ひれの黒いしま模様が目印。河口でまれに掛かる。"
    }
  },
